---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Lifestyle Community — Less."
    description="Find books, communities, and experts to support your lifestyle minimalism journey."
    path="/life/community"
    section="life"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Lifestyle Community</h1>
                <p class="subtitle">Live with less, together.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Recommended Reading</h2>
            <p class="section-intro">These books make the strongest case for owning less — and living more.</p>
            <div class="cards">
                <a href="https://konmari.com/marie-kondo-books/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Life-Changing Magic of Tidying Up</h3>
                    <p>By Marie Kondo. The book that sparked a global movement. A practical guide to decluttering your home and, by extension, your life.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://gregmckeown.com/books/essentialism/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Essentialism</h3>
                    <p>By Greg McKeown. The disciplined pursuit of less. A rigorous argument for doing fewer things at the highest possible level of contribution.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.becomingminimalist.com/the-more-of-less/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The More of Less</h3>
                    <p>By Joshua Becker. A practical and personal look at how owning less creates more freedom, generosity, and meaning in everyday life.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <Quote {...quotes.williamMorris} />

        <section class="content-section">
            <h2>Online Communities</h2>
            <p class="section-intro">You're not alone in this. These communities share tips, wins, and honest conversations about living with less.</p>
            <div class="cards">
                <a href="https://www.reddit.com/r/minimalism/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/minimalism</h3>
                    <p>A large, active community sharing photos, stories, and advice on minimalist living across every area of life.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.theminimalists.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Minimalists</h3>
                    <p>Joshua Fields Millburn and Ryan Nicodemus have helped millions live more meaningfully with less through essays, podcasts, and films.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.becomingminimalist.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Becoming Minimalist</h3>
                    <p>Joshua Becker's blog is one of the most read minimalism resources on the web — practical, warm, and grounded in real family life.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <section class="content-section next-step">
            <h2>The Journey Starts at Home</h2>
            <p class="section-intro">You've seen the tools, built the habits, and found the community. The only step left is yours.</p>
            <div class="next-step-links">
                <a href="/life" class="cta-button">Back to Life</a>
            </div>
        </section>
</Layout>
