---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Financial Community — Less."
    description="Find books, communities, and experts to support your financial minimalism journey."
    path="/money/community"
    section="money"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Financial Community</h1>
                <p class="subtitle">Simple money, shared wisdom.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Recommended Reading</h2>
            <p class="section-intro">These books cut through financial noise and show how simplicity is the most powerful wealth-building strategy.</p>
            <div class="cards">
                <a href="https://jlcollinsnh.com/stock-series/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Simple Path to Wealth</h3>
                    <p>By JL Collins. The clearest, most accessible argument for index fund investing ever written. Originally a series of letters to his daughter.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.vickirobin.com/books/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Your Money or Your Life</h3>
                    <p>By Vicki Robin. The foundational text of the financial independence movement. Reframes money as life energy and spending as a values question.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.iwillteachyoutoberich.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>I Will Teach You to Be Rich</h3>
                    <p>By Ramit Sethi. A practical, no-nonsense 6-week program to automate your finances, crush debt, and start investing — without cutting lattes.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <Quote {...quotes.willRogers} />

        <section class="content-section">
            <h2>Online Communities</h2>
            <p class="section-intro">Find others on the same path. These communities share strategies, accountability, and proof that financial simplicity works.</p>
            <div class="cards">
                <a href="https://www.reddit.com/r/personalfinance/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/personalfinance</h3>
                    <p>Millions of members sharing advice on budgeting, debt payoff, investing, and everything in between. Start with their wiki — it's excellent.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.reddit.com/r/financialindependence/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/financialindependence</h3>
                    <p>A community built around FIRE — Financial Independence, Retire Early. Thoughtful, data-driven discussion about building wealth and living freely.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.mrmoneymustache.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Mr. Money Mustache</h3>
                    <p>Pete Adeney retired at 30 on a modest salary by spending far less than he earned. His blog is one of the most influential in personal finance.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <section class="content-section next-step">
            <h2>The Journey Starts Now</h2>
            <p class="section-intro">You've seen the tools, built the habits, and found the community. Financial freedom is built one deliberate decision at a time.</p>
            <div class="next-step-links">
                <a href="/money" class="cta-button">Back to Money</a>
            </div>
        </section>
</Layout>
