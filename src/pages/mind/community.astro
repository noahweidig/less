---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Mental Community — Less."
    description="Find books, communities, and experts to support your mental minimalism journey."
    path="/mind/community"
    section="mind"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Mental Community</h1>
                <p class="subtitle">Simplify together, thrive together.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Recommended Reading</h2>
            <p class="section-intro">These books have guided millions toward a quieter, more intentional inner life.</p>
            <div class="cards">
                <a href="https://www.penguinrandomhouse.com/books/313412/meditations-by-marcus-aurelius/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Meditations</h3>
                    <p>By Marcus Aurelius. Private journal entries from a Roman emperor written with no intention of publication. Two thousand years old and still unmatched.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.oliverburkeman.com/books" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Four Thousand Weeks</h3>
                    <p>By Oliver Burkeman. A radical, liberating argument for accepting your limits — and finding meaning in the finite time you actually have.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.eckharttolle.com/the-power-of-now-book/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Power of Now</h3>
                    <p>By Eckhart Tolle. A guide to spiritual enlightenment through present-moment awareness. One of the most transformative books on the inner life ever written.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <Quote {...quotes.marcusAurelius} />

        <section class="content-section">
            <h2>Online Communities</h2>
            <p class="section-intro">Find others committed to a calmer, more intentional inner life — and the practices that get you there.</p>
            <div class="cards">
                <a href="https://www.reddit.com/r/meditation/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/meditation</h3>
                    <p>A welcoming community for practitioners of all experience levels. Questions, techniques, and honest accounts of what actually works.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.reddit.com/r/Stoicism/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/Stoicism</h3>
                    <p>Discussion of Stoic philosophy and its practical application to modern life. Grounded, thoughtful, and surprisingly warm for a subreddit about Stoics.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.theschooloflife.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The School of Life</h3>
                    <p>Essays, videos, and courses on emotional intelligence, relationships, and the art of living well — drawing on philosophy, psychology, and literature.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <section class="content-section next-step">
            <h2>The Journey Starts Within</h2>
            <p class="section-intro">You've seen the tools, built the habits, and found the community. A clearer mind awaits — one deliberate choice at a time.</p>
            <div class="next-step-links">
                <a href="/mind" class="cta-button">Back to Mind</a>
            </div>
        </section>
</Layout>
