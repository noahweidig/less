---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Mental Habits — Less."
    description="Build mental minimalism habits with simple daily practices for clarity and calm."
    path="/mind/habits"
    section="mind"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Mental Habits</h1>
                <p class="subtitle">Practices for clarity and calm.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-2"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Essential Practices</h2>
            <p class="section-intro">Mental clarity isn't about thinking harder — it's about creating conditions where clear thinking can happen naturally.</p>
            <div class="cards">
                <div class="card" data-tilt tabindex="0">
                    <h3>Morning Pages</h3>
                    <p>Three pages of longhand stream-of-consciousness writing first thing every morning. No editing, no rereading — just clearing mental clutter before the day begins.</p>
                </div>
                <div class="card" data-tilt tabindex="0">
                    <h3>Single-Tasking</h3>
                    <p>Do one thing at a time with full attention. Close all other tabs. Put your phone away. Multitasking is a myth — focused attention is the real skill.</p>
                </div>
                <div class="card" data-tilt tabindex="0">
                    <h3>The Power of No</h3>
                    <p>Every "yes" is a "no" to something else. Practice saying no to requests that don't align with your priorities — without guilt, without explanation.</p>
                </div>
            </div>
        </section>

        <Quote {...quotes.senecaShortness} />

        <section class="content-section steps">
            <h2>The Mental Declutter</h2>
            <p class="section-intro">A structured process for clearing the cognitive clutter that builds up invisibly over time.</p>
            <ul class="step-list" role="list">
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 1 as complete" aria-pressed="false" data-step-id="mental-step-1">
                        <span class="step-number">01</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Brain Dump</h3>
                        <p>Write down every open loop in your mind — tasks, worries, ideas, decisions. Getting it out of your head and onto paper reduces cognitive load immediately.</p>
                    </div>
                </li>
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 2 as complete" aria-pressed="false" data-step-id="mental-step-2">
                        <span class="step-number">02</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Eliminate or Delegate</h3>
                        <p>For each item: can it be dropped entirely? Can someone else handle it? Protect your attention for the things only you can do.</p>
                    </div>
                </li>
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 3 as complete" aria-pressed="false" data-step-id="mental-step-3">
                        <span class="step-number">03</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Protect Stillness</h3>
                        <p>Schedule unstructured time every day — no phone, no content, no productivity. Boredom is not the enemy. It's where insight lives.</p>
                    </div>
                </li>
            </ul>
        </section>

        <section class="content-section next-step">
            <h2>You're Not Alone in This</h2>
            <p class="section-intro">Books, teachers, and communities that make the journey toward clarity a shared one.</p>
            <div class="next-step-links">
                <a href="/mind/community" class="cta-button">Join the Community</a>
            </div>
        </section>
</Layout>
