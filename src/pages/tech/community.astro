---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Digital Community — Less."
    description="Find books, communities, and experts to support your digital minimalism journey."
    path="/tech/community"
    section="tech"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Community</h1>
                <p class="subtitle">The ideas and people that make this journey sustainable.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-1"></div>
                <div class="shape shape-3"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Recommended Reading</h2>
            <p class="section-intro">These books shaped the movement. Start here to understand the deeper case for living with less technology.</p>
            <div class="cards">
                <a href="https://calnewport.com/writing/#deep-work" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Deep Work</h3>
                    <p>By Cal Newport. Rules for focused success in a distracted world. A must-read for knowledge workers.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://calnewport.com/writing/#digital-minimalism" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Digital Minimalism</h3>
                    <p>By Cal Newport. The foundational text that argues for a philosophy of technology use based on your values.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.nicholascarr.com/?page_id=16" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Shallows</h3>
                    <p>By Nicholas Carr. How the internet is changing the way we think, read, and remember.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>

        <Quote {...quotes.senecaEverywhere} />

        <section class="content-section">
            <h2>Online Communities</h2>
            <p class="section-intro">Connect with others who are reclaiming their attention. The irony of an online community isn't lost — use it intentionally.</p>
            <div class="cards">
                <a href="https://www.reddit.com/r/digitalminimalism/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>r/digitalminimalism</h3>
                    <p>A Reddit community dedicated to sharing tips, success stories, and struggles with digital clutter.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://www.humanetech.com/" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>The Center for Humane Technology</h3>
                    <p>An organization dedicated to realigning technology with humanity's best interests.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="https://en.slow-media.net/manifest" class="card" data-tilt target="_blank" rel="noopener noreferrer">
                    <h3>Slow Media</h3>
                    <p>A movement advocating for the consumption of media that is thoughtful, verifiable, and sustainable.</p>
                    <span class="sr-only">(opens in a new tab)</span>
                </a>
            </div>
        </section>
        <section class="content-section next-step">
            <h2>The Journey Starts Now</h2>
            <p class="section-intro">You've seen the problem, learned the philosophy, and found the community. The only step left is yours.</p>
            <div class="next-step-links">
                <a href="/tech" class="cta-button">Back to Tech</a>
            </div>
        </section>
</Layout>
