---
import Layout from '../../layouts/Layout.astro';
import Quote from '../../components/Quote.astro';
import { quotes } from '../../data/citations';
---
<Layout
    title="Digital Habits — Less."
    description="Build digital minimalism habits with simple daily and weekly practices to reduce screen time."
    path="/tech/habits"
    section="tech"
>
        <section class="hero small">
            <div class="hero-content">
                <h1>Daily Habits</h1>
                <p class="subtitle">Small, deliberate changes that compound into a different life.</p>
            </div>
            <div class="hero-shapes">
                <div class="shape shape-2"></div>
                <div class="shape shape-3"></div>
            </div>
        </section>

        <section class="content-section">
            <h2>Essential Practices</h2>
            <p class="section-intro">You don't need to throw away your phone. Start with these three boundaries and see what changes.</p>
            <div class="cards">
                <div class="card" data-tilt tabindex="0">
                    <h3>Phone Foyer Method</h3>
                    <p>When you get home, plug your phone into a charging station in the foyer. Leave it there until you need it for a specific purpose.</p>
                </div>
                <div class="card" data-tilt tabindex="0">
                    <h3>Consolidated Texting</h3>
                    <p>Instead of responding immediately, set aside specific times during the day to check and reply to messages.</p>
                </div>
                <div class="card" data-tilt tabindex="0">
                    <h3>Weekly Digital Fast</h3>
                    <p>Take one day a week (like Sunday) to completely disconnect from all digital devices and reconnect with the physical world.</p>
                </div>
            </div>
        </section>

        <Quote {...quotes.calNewportThrive} />

        <section class="content-section steps">
            <h2>The 30-Day Declutter</h2>
            <p class="section-intro">Ready for a deeper reset? This structured process helps you rediscover what technology actually deserves a place in your life.</p>
            <ul class="step-list" role="list">
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 1 as complete" aria-pressed="false" data-step-id="habit-step-1">
                        <span class="step-number">01</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Identify</h3>
                        <p>List all optional technologies in your life (apps, streaming, social media).</p>
                    </div>
                </li>
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 2 as complete" aria-pressed="false" data-step-id="habit-step-2">
                        <span class="step-number">02</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Abstain</h3>
                        <p>Take a 30-day break from these technologies. Rediscover analog hobbies.</p>
                    </div>
                </li>
                <li class="step">
                    <button class="step-marker" aria-label="Mark step 3 as complete" aria-pressed="false" data-step-id="habit-step-3">
                        <span class="step-number">03</span>
                        <span class="step-check" aria-hidden="true" hidden>✓</span>
                    </button>
                    <div class="step-content">
                        <h3>Reintroduce</h3>
                        <p>Only bring back technologies that serve a high-value purpose in your life.</p>
                    </div>
                </li>
            </ul>
        </section>

        <section class="content-section next-step">
            <h2>You're Not Alone in This</h2>
            <p class="section-intro">Find books, communities, and thinkers who are walking the same path.</p>
            <div class="next-step-links">
                <a href="/tech/community" class="cta-button">Join the Community</a>
            </div>
        </section>
</Layout>
